{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "composite": true,
    "jsx": "react-jsx"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.test.ts",
    // Web-only helpers, imported by the .tsx pages and resolved by Vite (bundler mode, no .js extensions).
    "src/colaboradores-totals.ts",
    "src/loja-opcao.ts",
    "src/previous-closing-period.ts",
    "src/projecao.ts",
    "src/username-sugerido.ts"
  ]
}
