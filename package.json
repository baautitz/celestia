{
  "name": "celestia-root",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "check:ui": "node scripts/check-ui-boundaries.mjs",
    "check:ui:test": "node scripts/check-ui-boundaries.test.mjs",
    "test:watch": "vitest",
    "dev:server": "pnpm --filter @platform/server dev",
    "dev:web": "pnpm --filter @platform/web dev",
    "lint": "pnpm -r run lint"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.1",
    "esbuild": "^0.24.0",
    "hono": "^4.6.10",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.9.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.72.0",
    "vitest": "^2.1.4"
  }
}
