{
  "name": "celestia-root",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "workspaces": [
    "integrations/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "check:ui": "node scripts/check-ui-boundaries.mjs",
    "check:plugins": "node scripts/check-plugin-boundaries.mjs",
    "check:ui:test": "node scripts/check-ui-boundaries.test.mjs",
    "test:e2e": "pnpm --filter @platform/e2e test",
    "test:db": "node scripts/test-db.mjs",
    "db:migrate": "pnpm --filter @platform/server db:migrate && pnpm --filter @platform/ca db:migrate",
    "create-admin": "pnpm --filter @platform/server create-admin",
    "create-ca": "pnpm --filter @platform/ca create-ca",
    "erp:query": "pnpm --filter @platform/server erp:query",
    "test:watch": "vitest",
    "dev": "pnpm --parallel --filter @platform/server --filter @platform/ca --filter @platform/web dev",
    "dev:server": "pnpm --filter @platform/server dev",
    "dev:ca": "pnpm --filter @platform/ca dev",
    "dev:web": "pnpm --filter @platform/web dev",
    "dev:cert": "docker compose -f docker-compose.cert.yaml up",
    "lint": "pnpm -r run lint",
    "check": "pnpm check:ui && pnpm check:ui:test && pnpm check:plugins && pnpm lint && pnpm build && pnpm test",
    "prepare": "node scripts/setup-git-hooks.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.1",
    "esbuild": "^0.24.0",
    "hono": "^4.13.13",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.9.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.72.0",
    "vitest": "^2.1.4"
  }
}
