{
  "name": "@platform/server",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js",
    "dev": "tsx watch --conditions=source --env-file=../../.env src/index.ts",
    "db:migrate": "tsx --conditions=source --env-file=../../.env src/db/migrate.ts",
    "create-admin": "tsx --conditions=source --env-file=../../.env src/cli/create-admin.ts",
    "erp:query": "tsx --conditions=source --env-file=../../.env src/cli/erp-query.ts",
    "lint": "biome lint ."
  },
  "dependencies": {
    "@hono/node-server": "^2.0.0",
    "@hono/zod-validator": "^0.9.1",
    "@integrations/inovafarma": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "@platform/core": "workspace:*",
    "@platform/shared": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.19",
    "mssql": "^12.7.16",
    "pg": "^8.23.1",
    "pino": "^10.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=24"
  }
}
