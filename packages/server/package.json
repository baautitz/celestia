{
  "name": "@platform/server",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "db:migrate": "tsx --env-file=../../.env src/db/migrate.ts",
    "create-admin": "tsx --env-file=../../.env src/cli/create-admin.ts",
    "erp:query": "tsx --env-file=../../.env src/cli/erp-query.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.1",
    "@integrations/inovafarma": "workspace:*",
    "@node-rs/argon2": "^2.1.0",
    "@platform/core": "workspace:*",
    "@platform/shared": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.13",
    "mssql": "^12.7.4",
    "pg": "^8.23.1",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=24"
  }
