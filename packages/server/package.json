{
  "name": "@platform/server",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "db:generate": "drizzle-kit generate",
