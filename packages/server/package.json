    "create-admin": "tsx --env-file=../../.env src/cli/create-admin.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.1",
    "@node-rs/argon2": "^2.1.0",
    "@platform/shared": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "esbuild": "^0.24.0",
    "hono": "^4.6.10",
    "mssql": "^12.7.4",
    "pg": "^8.23.1",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
