{
  "name": "@platform/server",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js",
    "dev": "tsx watch --conditions=source --env-file=../../.env src/index.ts",
    "db:migrate": "tsx --conditions=source --env-file=../../.env src/db/migrate.ts",
    "create-admin": "tsx --conditions=source --env-file=../../.env src/cli/create-admin.ts",
    "erp:query": "tsx --conditions=source --env-file=../../.env src/cli/erp-query.ts",
    "lint": "biome lint ."
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@integrations/inovafarma": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "@platform/core": "workspace:*",
    "@platform/shared": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "mssql": "^12.7.15",
    "pg": "catalog:",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
