# Copie para .env (ignorado pelo git) e ajuste os valores.
POSTGRES_USER=celestia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=celestia
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Chave AES-256 (32 bytes em base64) que cifra as senhas das conexoes. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ERP_ENCRYPTION_KEY=

# Acesso por Dispositivo (mTLS). Em producao os quatro sao obrigatorios; sem eles o servidor nao sobe.
# Certificado publico do site (ex.: Let's Encrypt), apresentado ao navegador.
TLS_CERT_FILE=
TLS_KEY_FILE=
# CA que emite e valida os certificados dos Dispositivos. Crie uma vez com `pnpm create-ca`.
# Guarde a chave fora do banco e do repositorio, com backup.
DEVICE_CA_CERT_FILE=
DEVICE_CA_KEY_FILE=
