# Copie para .env (ignorado pelo git) e ajuste os valores.
POSTGRES_USER=celestia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=celestia
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Chave AES-256 (32 bytes em base64) que cifra as senhas das conexoes. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ERP_ENCRYPTION_KEY=
JWT_SECRET=

# Acesso por Dispositivo (certificado de cliente). Detalhes em docs/conventions/device-certificates.md.
# Fonte do certificado: header (producao, atras do Traefik) ou mock (SO desenvolvimento). Em branco = ninguem apresenta certificado.
CLIENT_CERT_SOURCE=mock
# mock: nome de um Dispositivo ativo a simular; sem ele ninguem apresenta certificado.
DEV_CLIENT_CERT_DEVICE=
# header: segredo (min. 32 caracteres) que o Traefik acrescenta; sem ele o certificado repassado e ignorado.
PROXY_SHARED_SECRET=
# CA que emite os certificados dos Dispositivos. Crie uma vez com `pnpm create-ca`.
# Guarde a chave fora do banco e do repositorio, com backup.
DEVICE_CA_CERT_FILE=
DEVICE_CA_KEY_FILE=
