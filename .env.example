# Copie para .env (ignorado pelo git) e ajuste os valores.
POSTGRES_USER=celestia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=celestia
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Chave AES-256 (32 bytes em base64) que cifra as senhas das conexoes. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ERP_ENCRYPTION_KEY=
JWT_SECRET=

# Acesso por Dispositivo (certificado de cliente). Detalhes em docs/conventions/device-certificates.md.
# A autoridade certificadora (services/ca) e um servico a parte: emite, revoga e le os certificados dos Dispositivos.
# Chave em comum entre o backend e a CA (min. 32 caracteres). Os dois lados leem a mesma variavel.
CA_SHARED_SECRET=
# Backend: endereco interno da CA (padrao em desenvolvimento: http://localhost:3001).
# CA_URL=http://localhost:3001
# CA: porta e enderecos. CA_PUBLIC_URL e o endereco com mTLS (acesso.seudominio); APP_CALLBACK_URL, o callback do app.
# CA_PORT=3001
# CA_PUBLIC_URL=http://localhost:3001
# APP_CALLBACK_URL=http://localhost:5173/login/certificado
# Fonte do certificado: header (producao, atras do Traefik) ou mock (SO desenvolvimento). Em branco = mock sem Dispositivo.
CA_CERT_SOURCE=mock
# mock: nome de um Dispositivo ativo a simular; sem ele ninguem apresenta certificado.
CA_MOCK_DEVICE=
# header: segredo (min. 32 caracteres) que o Traefik acrescenta; sem ele o certificado repassado e ignorado.
CA_PROXY_SECRET=
# CA que emite os certificados dos Dispositivos. Crie uma vez com `pnpm create-ca`.
# Guarde a chave fora do banco e do repositorio, com backup.
DEVICE_CA_CERT_FILE=
DEVICE_CA_KEY_FILE=
