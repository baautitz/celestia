    "hono": "catalog:",
    "node-forge": "1.4.3",
    "pg": "catalog:",
    "pino": "catalog:",
    "pkijs": "^4.0.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node-forge": "^1.3.14",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
