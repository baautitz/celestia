{
  "name": "@platform/ca",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch --conditions=source --env-file=../../.env src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "db:migrate": "tsx --conditions=source --env-file=../../.env src/migrate.ts",
    "create-ca": "tsx --conditions=source --env-file=../../.env src/cli/create-ca.ts",
    "lint": "biome lint ."
  },
  "dependencies": {
    "@hono/node-server": "^2.0.0",
    "@hono/zod-validator": "^0.9.1",
    "@platform/core": "workspace:*",
    "@platform/shared": "workspace:*",
    "asn1js": "^4.0.0",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.19",
    "node-forge": "1.4.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pkijs": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=24"
  }
}
