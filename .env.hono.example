# Producao: variaveis do servico `celestia` (imagem de packages/server/Dockerfile, API + SPA).
# Para desenvolvimento, use o .env.dev.example. Guia: docs/conventions/device-certificates.md
# A imagem ja define NODE_ENV=production, PORT=3000 e WEB_ROOT=./public.
# Para gerar uma chave aleatoria de 32 bytes (base64):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# ─── Banco de dados ──────────────────────────────────────────────────────────────────────────────────────────────
# O mesmo banco da CA. Sem POSTGRES_HOST o servico sobe com dados em memoria, que se perdem ao reiniciar.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=celestia
POSTGRES_PASSWORD=
POSTGRES_DB=celestia

# ─── Segredos ────────────────────────────────────────────────────────────────────────────────────────────────────
# Assina os tokens de acesso (min. 32 caracteres). OBRIGATORIO.
JWT_SECRET=
# Chave AES-128 (16 bytes em hex, 32 caracteres) que cifra as senhas das conexoes com os ERPs. OBRIGATORIA: sem ela o servidor nao sobe.
# Gere com: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))". Perder a chave obriga a cadastrar as senhas dos ERPs de novo.
ERP_ENCRYPTION_KEY=

# ─── Autoridade certificadora ────────────────────────────────────────────────────────────────────────────────────
# Chave em comum com a CA (min. 32 caracteres). OBRIGATORIA e igual nos dois servicos.
CA_SHARED_SECRET=
# Endereco INTERNO da CA, sem porta publicada. OBRIGATORIO.
CA_URL=http://ca:3001

# ─── Web ─────────────────────────────────────────────────────────────────────────────────────────────────────────
# Origens do app autorizadas no CORS, separadas por virgula.
CORS_ORIGINS=https://app.seudominio
