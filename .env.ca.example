# Producao: variaveis do servico `celestia-ca` (imagem de services/ca/Dockerfile).
# Para desenvolvimento, use o .env.dev.example. Guia: docs/conventions/device-certificates.md
# A imagem ja define NODE_ENV=production, CA_PORT=3001, CA_CERT_SOURCE=header, DEVICE_CA_CERT_FILE=/data/ca/ca.crt e
# DEVICE_CA_KEY_FILE=/data/ca/ca.key. Monte um volume nomeado em /data/ca e faca backup da ca.key.
# Para gerar uma chave aleatoria de 32 bytes (base64):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# ─── Banco de dados ──────────────────────────────────────────────────────────────────────────────────────────────
# O mesmo banco do backend (schema proprio "ca"). Sem POSTGRES_HOST o servico sobe com dados em memoria.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=celestia
POSTGRES_PASSWORD=
POSTGRES_DB=celestia

# ─── Segredos ────────────────────────────────────────────────────────────────────────────────────────────────────
# Chave em comum com o backend (min. 32 caracteres). OBRIGATORIA e igual nos dois servicos.
CA_SHARED_SECRET=
# Segredo que o Traefik acrescenta na requisicao (min. 32 caracteres). OBRIGATORIO e igual ao configurado no Traefik.
CA_PROXY_SECRET=

# ─── Enderecos ───────────────────────────────────────────────────────────────────────────────────────────────────
# Endereco publico da CA, com mTLS no Traefik. Na Cloudflare, so DNS (nuvem cinza). OBRIGATORIO.
CA_PUBLIC_URL=https://acesso.seudominio
# Para onde a CA devolve o navegador. OBRIGATORIO.
APP_CALLBACK_URL=https://app.seudominio/login/certificado

# ─── Opcionais ───────────────────────────────────────────────────────────────────────────────────────────────────
# So se o proxy nao for o Traefik (padroes: x-forwarded-tls-client-cert e x-celestia-proxy-secret):
# CA_CERT_HEADER=
# CA_PROXY_SECRET_HEADER=
